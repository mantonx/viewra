# ViewRA Development Dockerfile
# Provides hot-reload development environment with Air
#
# Prerequisites:
#   Run `make build-tools` first to build FFmpeg and subtitle-extractor into bin/
#   Run `make build-plugins` to build plugins into bin/plugins/
#
# Usage:
#   docker compose -f docker-compose.dev.yml up

FROM golang:1.25-bookworm

ARG DEBIAN_FRONTEND=noninteractive

# Install system dependencies (NO system FFmpeg - we use custom build)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    gcc \
    make \
    git \
    curl \
    # protobuf compiler
    protobuf-compiler \
    # FFmpeg runtime dependencies (for our custom build)
    libx264-164 \
    libx265-199 \
    libvpx9 \
    libsvtav1enc1d2 \
    libdav1d7 \
    libopus0 \
    libvorbis0a \
    libvorbisenc2 \
    libmp3lame0 \
    libfdk-aac2 \
    libass9 \
    libfreetype6 \
    libfontconfig1 \
    libssl3t64 \
    libva2 \
    libva-drm2 \
    libvdpau1 \
    libdrm2 \
    && rm -rf /var/lib/apt/lists/*

# Install Go tools
RUN go install github.com/air-verse/air@latest && \
    go install github.com/sqlc-dev/sqlc/cmd/sqlc@latest && \
    go install github.com/swaggo/swag/cmd/swag@latest && \
    go install -tags 'sqlite3 postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@latest && \
    go install google.golang.org/protobuf/cmd/protoc-gen-go@latest && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest

WORKDIR /app

# Copy go.mod first for dependency caching
COPY go.mod go.sum ./
RUN go mod download

# Set environment for development
ENV ENVIRONMENT=development \
    GIN_MODE=debug \
    CGO_ENABLED=1 \
    DATA_DIR=/app/data \
    PORT=8080

EXPOSE 8080 6060

# Default command runs Air for hot-reload
CMD ["air", "-c", ".air.toml"]
