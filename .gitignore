# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
build/

# Backup files
*.bak
*.backup
*.orig

# OpenCode config (may contain API keys)
opencode.json

# Go compiled binaries (prevent re-committing)
viewra
viewra-test
sqlc-gen
backend/viewra
backend/viewra-backend
backend/main
backend/server
backend/test-*

# Plugin binaries (never commit - distributed via releases)
# Source lives in plugins/, binaries in data/plugins/
data/plugins/
# Plugin binaries in source directories (built by make build-plugin)
# These are Go binaries with no extension, matching their directory name
plugins/*/*
!plugins/*/*.go
!plugins/*/*.md
!plugins/*/*.yaml
!plugins/*/*.yml
!plugins/*/*.toml
!plugins/*/go.mod
!plugins/*/go.sum
!plugins/*/internal/
plugins/*/internal/*
!plugins/*/internal/*.go

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage/

# Go workspace file
go.work

# Dependency directories
vendor/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# OpenCode config (contains API keys)
opencode.json

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite

# Runtime config and secrets (use env vars instead)
data/config.yaml
data/*.key

# Backup files
*.backup
backups/

# Logs
*.log
logs/

# Thumbnails and cached images
data/thumbnails/
data/images/
data/cache/

# Transcoded media
data/transcoded/
data/dash/

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Frontend build output
web/dist/
web/build/
web/.vite/

# Test data (media files)
test-data/
*.mp4
*.mkv
*.avi
*.mov
*.flac
*.mp3
*.m4a
# Keep README files in test-data
!test-data/README.md

# Temporary files
tmp/
temp/
*.tmp

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.directory
.Trash-*

